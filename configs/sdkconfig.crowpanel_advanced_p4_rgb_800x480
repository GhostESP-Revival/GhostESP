# Elecrow CrowPanel Advanced P4 5-inch RGB HMI profile.
# This panel uses a 16-bit RGB bus and the onboard STC8 for backlight control.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_BUILD_CONFIG_TEMPLATE="CrowPanel P4 5in RGB"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y

CONFIG_WITH_SCREEN=y
CONFIG_TFT_WIDTH=800
CONFIG_TFT_HEIGHT=480
CONFIG_USE_TOUCHSCREEN=y
CONFIG_CROWPANEL_ADVANCED_P4=y
CONFIG_CROWPANEL_P4_REV_V12_PLUS=y
CONFIG_CROWPANEL_P4_PANEL_RGB_800X480=y

CONFIG_LV_COLOR_DEPTH_16=y
# CONFIG_LV_COLOR_16_SWAP is not set
CONFIG_LV_FONT_MONTSERRAT_8=y
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_TOUCH_CONTROLLER_GT911=y
# CONFIG_LV_GT911_SWAPXY is not set
# CONFIG_LV_GT911_INVERT_X is not set
# CONFIG_LV_GT911_INVERT_Y is not set
CONFIG_USING_MMC_1_BIT=y
CONFIG_SD_MMC_CLK=43
CONFIG_SD_MMC_CMD=44
CONFIG_SD_MMC_D0=39
CONFIG_LV_I2C_TOUCH=y
CONFIG_LV_I2C_TOUCH_PORT_0=y
CONFIG_LV_I2C_TOUCH_PORT=0
CONFIG_I2C_MANAGER_0_ENABLED=y
CONFIG_I2C_MANAGER_0_SDA=45
CONFIG_I2C_MANAGER_0_SCL=46
CONFIG_I2C_MANAGER_0_FREQ_HZ=400000
CONFIG_I2C_MANAGER_0_TIMEOUT=100
CONFIG_I2C_MANAGER_0_LOCK_TIMEOUT=50
CONFIG_I2C_MANAGER_0_PULLUPS=y

CONFIG_SPIRAM=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_DISP_DEF_REFR_PERIOD=16
# Prefer internal DMA RAM for the hosted Wi-Fi mempool where it fits. The
# allocator falls back to DMA-capable PSRAM on P4 when internal RAM is full.
# CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM is not set

# Backlight is controlled indirectly by the STC8 over I2C.
# CONFIG_LV_DISP_BACKLIGHT_OFF is set
# CONFIG_LV_DISP_BACKLIGHT_SWITCH is not set
# CONFIG_LV_DISP_BACKLIGHT_PWM is not set
CONFIG_HAS_CROWPANEL_NS4168=y
CONFIG_HAS_AUDIO_PLAYER=y

# The P4 uses the onboard C6 through ESP-Hosted. NimBLE runs on the P4 host
# and the C6 supplies the Bluetooth controller over the hosted VHCI bridge.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
# CONFIG_BT_NIMBLE_TRANSPORT_UART is not set
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
# CONFIG_NFC_CHAMELEON is not set

# ESP-Hosted SDIO wiring to the onboard ESP32-C6.
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_PRIV_SDIO_OPTION=y
CONFIG_ESP_HOSTED_PRIV_SPI_HD_OPTION=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_SLOT=1
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=4
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=20
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=54
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=53
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=52
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=51
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=50
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=49
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=54
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=53
CONFIG_ESP_HOSTED_SDIO_PIN_D0=52
CONFIG_ESP_HOSTED_SDIO_PIN_D1=51
CONFIG_ESP_HOSTED_SDIO_PIN_D2=50
CONFIG_ESP_HOSTED_SDIO_PIN_D3=49
CONFIG_ESP_HOSTED_GPIO_SLAVE_RESET_SLAVE=20

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_crowpanel_p4.csv"
