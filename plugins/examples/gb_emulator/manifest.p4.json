{
  "id": "gb_emulator",
  "name": "GB Emulator",
  "version": "0.2.0",
  "author": "GhostESP",
  "description": "Game Boy and Game Boy Color emulator (gnuboy) with touch controls and save states for large panels.",
  "category": "Games",
  "entry": "gb_emulator.so",
  "target": "esp32p4",
  "api_version": 1,
  "manifest_version": 1,
  "package_version": 1,
  "data_version": 1,
  "storage_scope": "app",
  "icon": "icon.rgb565",
  "icon_source": "gb.png",
  "icon_format": "rgb565a8",
  "icon_width": 50,
  "icon_height": 50,
  "accent_color": "#306230",
  "permissions": ["ui", "input", "time", "storage"],
  "forward_back": true,
  "requires_features": ["touchscreen"],
  "assets": ["assets"],
  "memory_limit": 0,
  "stack_size": 8192,
  "tick_interval_ms": 16,
  "requires_psram": true
}
