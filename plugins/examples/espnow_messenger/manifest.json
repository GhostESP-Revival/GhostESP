{
  "id": "hackchat",
  "name": "HackChat",
  "version": "1.0.7",
  "author": "GhostESP",
  "description": "Send short nearby messages directly to other GhostESP devices over ESP-NOW.",
  "category": "Communication",
  "entry": "ghostesp_hackchat.so",
  "target": "esp32s3",
  "targets": ["esp32c5", "esp32s3"],
  "api_version": 1,
  "manifest_version": 1,
  "package_version": 1,
  "data_version": 1,
  "storage_scope": "app",
  "icon": "icon.rgb565",
  "icon_source": "chat.png",
  "icon_format": "true_color_alpha",
  "icon_width": 50,
  "icon_height": 50,
  "accent_color": "#7C5CFC",
  "permissions": ["ui", "espnow", "input"],
  "requires_features": ["joystick"],
  "memory_limit": 0,
  "stack_size": 8192,
  "tick_interval_ms": 250,
  "requires_psram": false
}
