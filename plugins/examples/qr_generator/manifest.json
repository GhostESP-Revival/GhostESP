{
  "id": "qr_generator",
  "name": "QR Generator",
  "version": "1.0.0",
  "author": "GhostESP",
  "description": "Create scannable QR codes from text or URLs using touch, keys, encoder, or D-pad input.",
  "category": "Tools",
  "entry": "qr_generator.so",
  "target": "esp32c5",
  "api_version": 1,
  "manifest_version": 1,
  "package_version": 1,
  "data_version": 1,
  "storage_scope": "app",
  "icon": "icon.rgb565",
  "icon_source": "qr-code.png",
  "icon_format": "rgb565a8",
  "icon_width": 50,
  "icon_height": 50,
  "accent_color": "#7C5CFC",
  "permissions": ["ui", "lvgl", "input", "display"],
  "memory_limit": 0,
  "stack_size": 8192,
  "requires_psram": false
}
