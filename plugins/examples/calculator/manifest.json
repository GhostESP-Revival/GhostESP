{
  "id": "calculator",
  "name": "Calculator",
  "version": "1.1.2",
  "author": "GhostESP",
  "description": "iOS-style calculator with touch, joystick, and encoder support.",
  "category": "Tools",
  "entry": "calculator.so",
  "target": "esp32s3",
  "targets": ["esp32c5", "esp32s3"],
  "api_version": 1,
  "manifest_version": 1,
  "package_version": 2,
  "data_version": 2,
  "storage_scope": "app",
  "icon": "icon.rgb565",
  "icon_source": "calculator.png",
  "icon_format": "rgb565a8",
  "icon_width": 50,
  "icon_height": 50,
  "accent_color": "#FF9F0A",
  "screenshots": [
    {
      "path": "screenshot.webp",
      "alt": "Calculator showing its numeric display, five-row keypad, orange operators, and touch Back button"
    }
  ],
  "assets": ["screenshot.webp"],
  "permissions": ["ui", "lvgl", "input", "display"],
  "requires_features": ["joystick"],
  "memory_limit": 0,
  "stack_size": 8192,
  "requires_psram": false
}
