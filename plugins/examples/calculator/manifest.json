{
  "id": "calculator",
  "name": "Calculator",
  "version": "1.0.0",
  "author": "GhostESP",
  "description": "iOS-style calculator with touch, joystick, and encoder support.",
  "category": "Tools",
  "entry": "calculator.so",
  "target": "esp32c5",
  "api_version": 1,
  "manifest_version": 1,
  "package_version": 1,
  "data_version": 1,
  "storage_scope": "app",
  "icon": "icon.rgb565",
  "icon_source": "calculator.png",
  "icon_format": "rgb565a8",
  "icon_width": 50,
  "icon_height": 50,
  "accent_color": "#FF9F0A",
  "permissions": ["ui", "lvgl", "input", "display"],
  "memory_limit": 0,
  "stack_size": 8192,
  "requires_psram": false
}
