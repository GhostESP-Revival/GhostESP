{{- $pages := slice -}}
{{- range .Site.RegularPages -}}
  {{- $version := index (split (strings.TrimPrefix "/" .RelPermalink) "/") 0 -}}
  {{- $entry := dict "version" $version "title" .Title "description" ((.Params.description | default .Summary) | plainify) "permalink" .RelPermalink "content" (.Plain | plainify) -}}
  {{- $pages = $pages | append $entry -}}
{{- end -}}
{{- $pages | jsonify -}}
