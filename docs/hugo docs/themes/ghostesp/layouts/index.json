{{- /* Site-wide search index for the sidebar and general consumers.
     Includes full page text so results can show matching snippets. */ -}}
{{- $pages := slice -}}
{{- range .Site.RegularPages -}}
  {{- $entry := partial "index-entry.html" (dict "page" . "withContent" true) -}}
  {{- if $entry -}}
    {{- $pages = $pages | append $entry -}}
  {{- end -}}
{{- end -}}
{{- $pages | jsonify -}}
